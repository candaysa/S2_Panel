APP_NAME="S2 Panel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=panel
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=s2_panel
DB_USERNAME=root
DB_PASSWORD=

# Swiftly (admin plugin) database
SWIFTLY_DB_HOST=127.0.0.1
SWIFTLY_DB_PORT=3306
SWIFTLY_DB_DATABASE=swiftly
SWIFTLY_DB_USERNAME=root
SWIFTLY_DB_PASSWORD=

# Ranks plugin database
RANKS_DB_HOST=127.0.0.1
RANKS_DB_PORT=3306
RANKS_DB_DATABASE=ranks
RANKS_DB_USERNAME=root
RANKS_DB_PASSWORD=

# WeaponSkins plugin database
WEAPONSKINS_DB_HOST=127.0.0.1
WEAPONSKINS_DB_PORT=3306
WEAPONSKINS_DB_DATABASE=weaponskins
WEAPONSKINS_DB_USERNAME=root
WEAPONSKINS_DB_PASSWORD=

# VIPCore plugin database (https://github.com/SwiftlyS2-Plugins/VIPCore)
VIP_DB_HOST=127.0.0.1
VIP_DB_PORT=3306
VIP_DB_DATABASE=vip
VIP_DB_USERNAME=root
VIP_DB_PASSWORD=

# Steam OpenID
STEAM_API_KEY=
STEAM_CLIENT_ID=
STEAM_CLIENT_SECRET=
STEAM_CALLBACK_URL=http://localhost:8000/api/auth/callback

# First owner (set during install; SteamID64 format)
OWNER_STEAM_ID=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Module toggles — set to "true" to enable a module
MODULE_ADMIN=true
MODULE_AUDIT=true
MODULE_BAN=true
MODULE_RANK=true
MODULE_SKIN=true
MODULE_VIP=true
MODULE_REPORTS=true
MODULE_APPEALS=true
MODULE_SERVERS=true
MODULE_RCON=true
MODULE_SETTINGS=true
MODULE_I18N=true
MODULE_HEALTH=true
MODULE_WEBHOOKS=true
MODULE_CHEAT_CHECK=true

# Shared secret the cheat check scanner uses to post its results back.
# Optional: left empty it is derived from APP_KEY, which is already unique
# per install. Set it explicitly only to rotate the secret on its own.
CHEAT_CHECK_API_KEY=
